<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Add Movie — MovieLens
    </title>

    <link
        rel="stylesheet"
        href="/css/addmovie.css"
    >

</head>


<body>


<header class="site-header">

    <div class="header-inner">

        <a href="/" class="brand">

            <span class="brand-mark">
                M
            </span>

            <span>
                MovieLens
            </span>

        </a>


        <a
            href="/"
            class="button button-ghost"
        >
            ← Back to Movies
        </a>

    </div>

</header>


<main class="form-page">


    <div class="form-intro">

        <span class="eyebrow">
            ADMIN AREA
        </span>

        <h1>
            Add a new movie.
        </h1>

        <p>
            Expand the collection with the
            details viewers need to discover
            their next favourite.
        </p>

    </div>


    <form
        action="/addMovie"
        method="POST"
        enctype="multipart/form-data"
        class="movie-form"
    >


        <section class="form-card">


            <div class="form-section-heading">

                <span>
                    01
                </span>

                <div>

                    <h2>
                        Movie information
                    </h2>

                    <p>
                        Basic details about the film.
                    </p>

                </div>

            </div>


            <div class="field">

                <label for="title">
                    Movie title
                </label>

                <input
                    type="text"
                    id="title"
                    name="title"
                    placeholder="e.g. Interstellar"
                    required
                >

            </div>


            <div class="field">

                <label for="description">
                    Description
                </label>

                <textarea
                    id="description"
                    name="description"
                    rows="6"
                    placeholder="Write a short description..."
                    required
                ></textarea>

            </div>


            <div class="field-grid">


                <div class="field">

                    <label for="genre">
                        Genres
                    </label>

                    <input
                        type="text"
                        id="genre"
                        name="genre"
                        placeholder="Action, Drama, Sci-Fi"
                        required
                    >

                    <small>
                        Separate multiple genres
                        with commas.
                    </small>

                </div>


                <div class="field">

                    <label for="actors">
                        Actors
                    </label>

                    <input
                        type="text"
                        id="actors"
                        name="actors"
                        placeholder="Actor One, Actor Two"
                        required
                    >

                    <small>
                        Separate names with commas.
                    </small>

                </div>


            </div>


        </section>


        <section class="form-card">


            <div class="form-section-heading">

                <span>
                    02
                </span>

                <div>

                    <h2>
                        Media
                    </h2>

                    <p>
                        Add the poster and trailer.
                    </p>

                </div>

            </div>


            <div class="field">

                <label for="poster">
                    Poster image
                </label>

                <input
                    type="file"
                    id="poster"
                    name="poster"
                    accept="image/*"
                    required
                >

                <small>
                    Use a clear, high-quality
                    movie poster.
                </small>

            </div>


            <div class="field">

                <label for="trailer">
                    Trailer URL
                </label>

                <input
                    type="text"
                    id="trailer"
                    name="trailer"
                    placeholder="https://www.youtube.com/embed/VIDEO_ID"
                    required
                >

                <small>
                    Use a YouTube embed URL.
                </small>

            </div>


        </section>


        <div class="form-actions">

            <a
                href="/"
                class="button button-ghost"
            >
                Cancel
            </a>

            <button
                type="submit"
                class="button button-primary"
            >
                Add Movie
            </button>

        </div>


    </form>


</main>


</body>

</html>