<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= movie.title %> — MovieLens
    </title>

    <link
        rel="stylesheet"
        href="/css/viewdetails.css"
    >

</head>


<body>


<header class="site-header">

    <div class="header-inner">

        <a href="/" class="brand">

            <span class="brand-mark">
                M
            </span>

            <span>
                MovieLens
            </span>

        </a>


        <div class="header-actions">

            <a
                href="/"
                class="button button-ghost"
            >
                ← All Movies
            </a>


            <% if (isAdmin) { %>

                <a
                    href="/addMovie"
                    class="button button-primary"
                >
                    + Add Movie
                </a>

                <a
                    href="/logout"
                    class="button button-ghost"
                >
                    Logout
                </a>

            <% } %>

        </div>

    </div>

</header>


<main class="details-page">


    <a
        href="/"
        class="back-link"
    >
        ← Back to collection
    </a>


    <section class="movie-hero">


        <div class="poster-column">

            <% if (movie.poster) { %>

                <img
                    src="<%= movie.poster %>"
                    alt="<%= movie.title %>"
                    class="movie-poster"
                >

            <% } else { %>

                <div class="poster-placeholder">
                    MovieLens
                </div>

            <% } %>

        </div>


        <div class="movie-info">

            <span class="eyebrow">
                MOVIE DETAILS
            </span>


            <h1>
                <%= movie.title %>
            </h1>


            <div class="detail-tags">

                <% if (
                    movie.genre &&
                    movie.genre.length
                ) { %>

                    <% movie.genre.forEach(
                        function(genre)
                    { %>

                        <span>
                            <%= genre %>
                        </span>

                    <% }); %>

                <% } %>

            </div>


            <div class="rating-summary">

                <span class="rating-star">
                    ★
                </span>

                <div>

                    <strong>
                        <%= movie.averageRating || '0.0' %>
                    </strong>

                    <small>
                        average rating
                    </small>

                </div>

            </div>


            <p class="description">
                <%= movie.description %>
            </p>


            <div class="cast-block">

                <span class="label">
                    CAST
                </span>

                <p>

                    <%= movie.actors &&
                        movie.actors.length
                        ? movie.actors.join(' · ')
                        : 'No cast information available.'
                    %>

                </p>

            </div>


            <% if (movie.trailer) { %>

                <a
                    href="#trailer"
                    class="button button-primary"
                >
                    Watch Trailer ↓
                </a>

            <% } %>


            <% if (isAdmin) { %>

                <form
                    action="/deleteMovie/<%= movie._id %>"
                    method="POST"
                    onsubmit="return confirm('Delete this movie?');"
                    class="delete-form"
                >

                    <button
                        type="submit"
                        class="danger-link"
                    >
                        Delete movie
                    </button>

                </form>

            <% } %>


        </div>

    </section>


    <% if (movie.trailer) { %>

        <section
            class="trailer-section"
            id="trailer"
        >

            <div class="section-heading">

                <div>

                    <span class="section-kicker">
                        TRAILER
                    </span>

                    <h2>
                        Watch the trailer
                    </h2>

                </div>

            </div>


            <div class="trailer-frame">

                <iframe
                    src="<%= movie.trailer %>"
                    title="<%= movie.title %> trailer"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                ></iframe>

            </div>

        </section>

    <% } %>


    <section class="reviews-layout">


        <div class="review-form-panel">

            <span class="section-kicker">
                YOUR TAKE
            </span>

            <h2>
                Leave a review
            </h2>

            <p>
                Share your thoughts and rate
                this movie.
            </p>


            <form
                action="/addReview/<%= movie._id %>"
                method="POST"
                class="review-form"
            >


                <label for="username">
                    Your name
                </label>

                <input
                    id="username"
                    type="text"
                    name="username"
                    placeholder="Enter your name"
                    required
                >


                <label for="rating">
                    Rating
                </label>

                <input
                    id="rating"
                    type="number"
                    name="rating"
                    min="1"
                    max="5"
                    placeholder="1–5"
                    required
                >


                <label for="reviewText">
                    Review
                </label>

                <textarea
                    id="reviewText"
                    name="reviewText"
                    rows="5"
                    placeholder="What did you think?"
                    required
                ></textarea>


                <button
                    type="submit"
                    class="button button-primary"
                >
                    Submit review
                </button>

            </form>

        </div>


        <div class="reviews-panel">


            <div class="section-heading">

                <div>

                    <span class="section-kicker">
                        COMMUNITY
                    </span>

                    <h2>
                        Reviews
                    </h2>

                </div>


                <span class="review-count">

                    <%= movie.reviews
                        ? movie.reviews.length
                        : 0 %>

                </span>

            </div>


            <% if (
                movie.reviews &&
                movie.reviews.length
            ) { %>


                <div class="review-list">

                    <% movie.reviews
                        .slice()
                        .reverse()
                        .forEach(
                            function(review)
                    { %>


                        <article
                            class="review-card"
                        >

                            <div class="review-top">

                                <strong>
                                    <%= review.user %>
                                </strong>

                                <span>
                                    Viewer
                                </span>

                            </div>


                            <p>
                                <%= review.text %>
                            </p>

                        </article>


                    <% }); %>

                </div>


            <% } else { %>


                <div class="empty-reviews">

                    <span>
                        ✦
                    </span>

                    <h3>
                        Be the first to review
                    </h3>

                    <p>
                        No reviews yet.
                        Start the conversation.
                    </p>

                </div>


            <% } %>


        </div>

    </section>


</main>

</body>

</html>